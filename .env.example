# Wspólna konfiguracja całego projektu. Skopiuj do `.env` w katalogu głównym repo
# i uzupełnij. Plik `.env` nie trafia do repozytorium. Starszy `backend/.env` jest
# czytany jako zapas (zmienne z `.env` i ze środowiska mają pierwszeństwo).

# ── Model językowy (textAnalysis, werdykt, analiza manipulacji i dat) ─────────
# Dowolny endpoint zgodny z API OpenAI (np. Gemini: https://generativelanguage.googleapis.com/v1beta/openai/,
# Ollama: http://<host>:11434/v1 – wtedy klucz może być dowolnym niepustym tekstem).
FREELLM_API_KEY=
FREELLM_BASE_URL=
FREELLM_MODEL=gemini-3.5-flash-lite
FREELLM_TIMEOUT=60
FREELLM_MAX_RETRIES=2
# Opcjonalnie: osobny model tylko do wyodrębniania twierdzeń
# TEXT_ANALYSIS_MODEL=

# Werdykt (analysis/src/prawdowid_analysis)
VERDICT_JSON_MODE=false
VERDICT_CONCURRENCY=3
VERDICT_MAX_SOURCE_AGE_DAYS=730

# Analiza manipulacji i dat (analysis/inputDataAnalysis), opcjonalne
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.1
# LLM_MAX_RETRIES=5

# ── Źródła ────────────────────────────────────────────────────────────────────
GOOGLE_FACT_CHECK_API_KEY=

# Pobieranie artykułów: 'local' bez API (fetch + trafilatura), 'diffbot' wymaga tokenu
ARTICLE_EXTRACTOR=local
DIFFBOT_API_TOKEN=
ARTICLE_SCRAPING_ENABLED=true
ARTICLE_MAX_CONCURRENCY=1
ARTICLE_MAX_LINKS=5
ARTICLE_MAX_USER_LINKS=2
ARTICLE_BATCH_TIMEOUT=60

# Lista stron zaufanych (trustedSources): z bazy, gdy jest DATABASE_URL, inaczej z kodu
TRUSTED_SOURCE_TIMEOUT=6
TRUSTED_SOURCE_CACHE_TTL=1200

# Znana dezinformacja (knownDisinfo): EUvsDisinfo MCP. Bez klucza sprawdzanie jest wyłączone.
EUvsDisinfo_API_KEY=
EUVSDISINFO_MCP_URL=https://mcp.euvsd.info/mcp
EUVSDISINFO_MCP_TIMEOUT=20
KNOWN_DISINFO_MAX_CANDIDATES=5
KNOWN_DISINFO_ENABLED=true

# ── Baza PostgreSQL ───────────────────────────────────────────────────────────
# Konta panelu, tokeny, strony zaufane, dziennik działań i zapytań, zgłoszenia z API strony.
# Tabele: z katalogu backend/ `python -m database migrate`.
DATABASE_URL=postgresql://uzytkownik:haslo@host:5432/prawdowid
# API strony (server:app) domyślnie wymaga zweryfikowanego SSL. Baza bez SSL (np. w sieci
# Tailscale albo lokalnie): disable.
# DATABASE_SSL_MODE=verify-full
# DATABASE_SCHEMA=public
# ACCOUNTS_REGISTRATION=open   # open | closed (rejestracja kont serwisu)
# ADMIN_API_TOKEN=             # awaryjny dostęp do panelu admina bez konta (najlepiej nie ustawiać)

# ── API strony (server:app, zob. backend/API.md) ─────────────────────────────
# CORS_ORIGINS=https://prawdowid.example.pl
# CHECK_TIMEOUT_SECONDS=360
# MAX_CONCURRENT_CHECKS=4
# REPORT_RETENTION_DAYS=180

# ── Frontend (frontend/, Vite czyta ten plik: envDir '..') ────────────────────
# mock – przykładowe odpowiedzi bez backendu (domyślnie); live – prawdziwe API.
# `npm run dev:live` włącza live bez zmiany tego pliku.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api
# Limit czasu sprawdzenia; dopasuj do CHECK_TIMEOUT_SECONDS.
# VITE_CHECK_TIMEOUT_MS=360000
# Pasek z przykładami na górze strony; domyślnie tylko w trybie mock.
# VITE_DEMO_BAR=true
VITE_WHATSAPP_NUMBER=+48 22 000 00 00
# Tylko dev: dokąd Vite przekazuje zapytania.
#   Backend (strona i WhatsApp): PYTHONPATH=backend:analysis:analysis/src uvicorn server:app --port 8000
#   Osobny adapter WhatsApp (np. offline demo): cd whatsapp_sim/backend && python -m whatsappAdapter --demo
# API_PROXY_TARGET=http://127.0.0.1:8000
# WHATSAPP_PROXY_TARGET=http://127.0.0.1:8001   # tylko dla osobnego adaptera

# ── Kanał WhatsApp (/api/whatsapp/* w server:app) ─────────────────────────────
# live (domyślnie) – ta sama weryfikacja co strona; factcheck – tylko Google Fact Check
# (szybko, bez oceny modelu); demo – przykładowe dane bez sieci i kluczy.
# SPRAWDZTO_MODE=live
# WHATSAPP_ENABLED=true
