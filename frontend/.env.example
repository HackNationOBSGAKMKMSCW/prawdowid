# Skopiuj do .env.local i dostosuj.

# mock – przykładowe odpowiedzi bez backendu (domyślnie)
# live – zapytania do backendu pod VITE_API_BASE_URL
VITE_API_MODE=mock

# Adres API. W dev Vite przekierowuje /api na API_PROXY_TARGET.
VITE_API_BASE_URL=/api

# Tylko dev (vite.config.ts): dokąd Vite przekazuje zapytania.
# API strony (z katalogu głównego repo, zob. backend/API.md):
#   PYTHONPATH=backend:analysis:analysis/src uvicorn server:app --port 8000
# API_PROXY_TARGET=http://127.0.0.1:8000
# Symulator WhatsApp: cd whatsapp_sim/backend && python -m whatsappAdapter --port 8001
# WHATSAPP_PROXY_TARGET=http://127.0.0.1:8001

# Limit czasu sprawdzenia (API zwraca wynik synchronicznie; domyślnie 6 minut).
# VITE_CHECK_TIMEOUT_MS=360000

# Pasek z przykładami na górze strony. Domyślnie widoczny tylko w trybie mock.
# VITE_DEMO_BAR=true

# Numer WhatsApp pokazywany na stronie startowej.
VITE_WHATSAPP_NUMBER=+48 22 000 00 00
