# Konfiguracja backendu na serwerze: skopiuj do /opt/prawdowid/.env
#   sudo -u prawdowid cp deploy/server.env.example .env && sudo chmod 600 .env
# Wartości w <...> uzupełnij. Strona i panel są budowane przez deploy/build-frontend.sh
# (ustawia własne VITE_*), więc tu nie ma zmiennych frontendu.

# ── Model: API OpenAI ────────────────────────────────────────────────────────
FREELLM_API_KEY=<klucz z https://platform.openai.com/api-keys>
FREELLM_BASE_URL=https://api.openai.com/v1
FREELLM_MODEL=gpt-6.2-sol
FREELLM_TIMEOUT=90
FREELLM_MAX_RETRIES=2
# gpt-6.2-sol odrzuca "none"; low to najniższy przyjmowany poziom rozumowania.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── Baza: Postgres na tym samym serwerze ─────────────────────────────────────
# Połączenie przez localhost, więc bez TLS. Port 5432 NIE jest otwarty na świat.
DATABASE_URL=postgresql://prawdowid:<nowe-haslo>@127.0.0.1:5432/prawdowid
DATABASE_SSL_MODE=disable
REPORT_RETENTION_DAYS=180

# ── API ──────────────────────────────────────────────────────────────────────
# Strona, panel i API są pod jednym adresem (Caddy), więc CORS nie jest potrzebny.
CORS_ORIGINS=
CHECK_TIMEOUT_SECONDS=300
MAX_CONCURRENT_CHECKS=4
# Losowy ciąg: openssl rand -hex 32
ADMIN_USER_SALT=<losowy-ciag>

# ── Źródła ───────────────────────────────────────────────────────────────────
GOOGLE_FACT_CHECK_API_KEY=<nowy klucz Google Fact Check Tools>
ARTICLE_EXTRACTOR=local
ARTICLE_SCRAPING_ENABLED=true
ARTICLE_MAX_CONCURRENCY=3
ARTICLE_MAX_LINKS=10
ARTICLE_MAX_USER_LINKS=2
ARTICLE_BATCH_TIMEOUT=120
TRUSTED_SOURCE_TIMEOUT=6
TRUSTED_SOURCE_CACHE_TTL=1200
EUVSDISINFO_API_KEY=
EUVSDISINFO_MCP_URL=https://mcp.euvsd.info/mcp
EUVSDISINFO_MCP_TIMEOUT=20
KNOWN_DISINFO_MAX_CANDIDATES=5
KNOWN_DISINFO_ENABLED=true

# ── Logi (plik: LOG_FILE z usługi systemd, /var/lib/prawdowid/logs/app.jsonl) ─
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_CONSOLE=false

# ── WhatsApp ─────────────────────────────────────────────────────────────────
SPRAWDZTO_MODE=live
TRUSTED_SOURCES_WARM=true
