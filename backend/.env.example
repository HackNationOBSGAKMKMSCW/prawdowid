# Text analysis (OpenAI-compatible endpoint)
FREELLM_API_KEY=
FREELLM_BASE_URL=
FREELLM_MODEL=gpt-4o-mini
FREELLM_TIMEOUT=30
FREELLM_MAX_RETRIES=2

# Google Fact Check Tools API
GOOGLE_FACT_CHECK_API_KEY=

# Article extraction. 'local' needs no API (fetch + trafilatura); 'diffbot' needs a token.
ARTICLE_EXTRACTOR=local
DIFFBOT_API_TOKEN=
ARTICLE_SCRAPING_ENABLED=true
ARTICLE_MAX_CONCURRENCY=1
ARTICLE_MAX_LINKS=5
ARTICLE_MAX_USER_LINKS=2
ARTICLE_BATCH_TIMEOUT=60

# Trusted-source whitelist (trustedSources). The list is hardcoded in
# trustedSources/whitelist.py (later: PostgreSQL table).
TRUSTED_SOURCE_TIMEOUT=6
TRUSTED_SOURCE_CACHE_TTL=1200

# Known disinformation (knownDisinfo): EUvsDisinfo MCP. A claim found there is labelled
# "Zweryfikowana rosyjska dezinformacja". No key = check disabled. Later: PostgreSQL.
EUvsDisinfo_API_KEY=
EUVSDISINFO_MCP_URL=https://mcp.euvsd.info/mcp
EUVSDISINFO_MCP_TIMEOUT=20
KNOWN_DISINFO_MAX_CANDIDATES=5
KNOWN_DISINFO_ENABLED=true
