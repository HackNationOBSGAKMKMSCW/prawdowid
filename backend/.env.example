# Panel admina (backend/admin): hasło do API panelu, wymyśl długi losowy ciąg, np.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Bez niego panel jest wyłączony (503). Ten sam token wpisujesz przy logowaniu w panelu.
ADMIN_API_TOKEN=
# Opcjonalnie: baza panelu (wspólna z botem WhatsApp) i sól pseudonimizacji użytkowników
# ADMIN_DB_PATH=admin/data/admin.db
# ADMIN_USER_SALT=

# Text analysis (OpenAI-compatible endpoint)
FREELLM_API_KEY=
FREELLM_BASE_URL=
FREELLM_MODEL=gpt-4o-mini
FREELLM_TIMEOUT=30
FREELLM_MAX_RETRIES=2

# Google Fact Check Tools API
GOOGLE_FACT_CHECK_API_KEY=

# Article extraction. 'local' needs no API (fetch + trafilatura); 'diffbot' needs a token.
ARTICLE_EXTRACTOR=local
DIFFBOT_API_TOKEN=
ARTICLE_SCRAPING_ENABLED=true
ARTICLE_MAX_CONCURRENCY=1
ARTICLE_MAX_LINKS=5
ARTICLE_MAX_USER_LINKS=2
ARTICLE_BATCH_TIMEOUT=60

# Trusted-source whitelist (trustedSources). With DATABASE_URL the list comes from the
# trusted_sources table (seed: python -m database seed-sources); without it, from
# trustedSources/whitelist.py. TRUSTED_SOURCES_STORE=static forces the code list.
TRUSTED_SOURCE_TIMEOUT=6
TRUSTED_SOURCE_CACHE_TTL=1200

# Baza PostgreSQL serwisu (konta, tokeny, strony zaufane, dziennik dzialan i zapytan).
# Tabele: python -m database migrate (z katalogu backend/). Bez DATABASE_URL panel
# admina dziala na SQLite (ADMIN_DB_PATH) i tylko z ADMIN_API_TOKEN.
DATABASE_URL=postgresql://uzytkownik:haslo@host:5432/prawdowid
# DATABASE_SCHEMA=public
# ADMIN_API_TOKEN=           # awaryjny dostep administratora (bez konta)
# ACCOUNTS_REGISTRATION=open # open | closed (rejestracja kont serwisu)
