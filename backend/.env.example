# Skopiuj do backend/.env i uzupełnij. Plik .env jest w .gitignore.
LLM_API_KEY=wklej-klucz-z-google-ai-studio
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Dokładna nazwa modelu z panelu (np. rodzina Gemini Flash Lite)
LLM_MODEL=gemini-flash-lite-latest
# Opcjonalne
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
