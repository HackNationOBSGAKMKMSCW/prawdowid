# Skopiuj do backend/.env i uzupełnij. Plik .env nie trafia do repozytorium.

# LLM: dowolne API zgodne z OpenAI. Domyślnie lokalna Ollama (klucz nie jest sprawdzany).
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=
LLM_TIMEOUT_S=60

# Retriever: mock (atrapa) do czasu podpięcia indeksu osoby A
RETRIEVER=mock

# Limit żądań /api/check na adres IP na minutę (0 wyłącza)
RATE_LIMIT_PER_MINUTE=10
# 1 tylko za zaufanym proxy, które ustawia X-Forwarded-For
TRUST_PROXY_HEADERS=0
