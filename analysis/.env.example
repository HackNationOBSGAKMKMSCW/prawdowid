# Skopiuj do analysis/.env i uzupełnij. Plik .env nie trafia do repozytorium.

# ── Werdykt (src/prawdowid_analysis) ─────────────────────────────────────────
# Te same nazwy co w backend/.env.example, więc jeden zestaw zmiennych obsługuje oba pakiety
# (brakujące wartości są uzupełniane z backend/.env).
# Model językowy: dowolny endpoint zgodny z OpenAI (np. FreeLLMAPI: http://<host>:3001/v1)
FREELLM_API_KEY=
FREELLM_BASE_URL=
FREELLM_MODEL=gemini-3.5-flash-lite
FREELLM_TIMEOUT=60
FREELLM_MAX_RETRIES=2

# Opcjonalnie: wymuszenie trybu JSON po stronie API (response_format=json_object).
# Nie każdy dostawca go obsługuje; domyślnie wyłączone, JSON wymusza prompt i walidacja.
VERDICT_JSON_MODE=false

# Ile twierdzeń oceniać równolegle (chroni przed limitem zapytań, HTTP 429)
VERDICT_CONCURRENCY=3

# Limit aktualności źródeł w dniach (od publikacji do daty zdarzenia z twierdzenia).
# Starsze źródła są oznaczane jako materiał archiwalny.
VERDICT_MAX_SOURCE_AGE_DAYS=730

# ── Analiza języka inputu (inputDataAnalysis) ────────────────────────────────
# Moduł NIE czyta tego pliku. Jego zmienne (LLM_API_KEY, LLM_BASE_URL, LLM_MODEL, ...)
# ustaw w analysis/inputDataAnalysis/.env według szablonu
# analysis/inputDataAnalysis/.env.example albo jako zmienne środowiskowe.
