# Skopiuj do analysis/.env i uzupełnij. Plik .env nie trafia do repozytorium.
# Wartości przekazujemy bezpośrednio lub przez menedżer haseł, nigdy przez czat ani repo.

# LLM: API zgodne z OpenAI, docelowo FreeLLMAPI (http://<host>:3001/v1).
# OPENAI_API_KEY: klucz `freellmapi-…` ze strony Keys w panelu FreeLLMAPI.
# LLM_MODEL: `auto` / `auto:<profil>` (router z failoverem) albo przypięty model z GET /v1/models.
# Do ewaluacji lepiej przypiąć model: przy `auto` odpowiadać mogą różne modele
# (faktyczny model zapisujemy z nagłówka X-Routed-Via).
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
# Opcjonalnie: limit czasu klienta w s (router FreeLLMAPI ma budżet failoveru 45 s)
LLM_TIMEOUT_S=60
EMBEDDING_MODEL=bge-m3
# Opcjonalnie: osobny endpoint/klucz tylko dla embeddingów (domyślnie OPENAI_*).
# Gdy OPENAI_BASE_URL wskazuje FreeLLMAPI, a embeddingi idą z Ollamy (bge-m3),
# ustaw tu adres Ollamy (http://<host>:11434/v1).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Indeks wektorowy (REST)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=prawdowid_passages

# Retriever dla części werdyktu: mock (atrapa, bez sieci) albo qdrant
RETRIEVER=mock

# Strojenie RAG (opcjonalne)
CHUNK_CHARS=800
PREFETCH_LIMIT=30
