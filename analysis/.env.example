# Skopiuj do analysis/.env i uzupełnij. Plik .env nie trafia do repozytorium.
# Wartości przekazujemy bezpośrednio lub przez menedżer haseł, nigdy przez czat ani repo.

# LLM i embeddingi: dowolne API zgodne z OpenAI (np. Ollama: http://<host>:11434/v1)
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=bge-m3
# Opcjonalnie: osobny endpoint/klucz tylko dla embeddingów (domyślnie OPENAI_*)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Indeks wektorowy (REST)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=prawdowid_passages

# Retriever dla części werdyktu: mock (atrapa, bez sieci) albo qdrant
RETRIEVER=mock

# Strojenie RAG (opcjonalne)
CHUNK_CHARS=800
PREFETCH_LIMIT=30
