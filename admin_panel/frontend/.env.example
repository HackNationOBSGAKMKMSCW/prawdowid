# Build-time defaults. public/config.json (read at runtime) overrides them,
# so a deployment can point the panel at another API without a rebuild.
#
# http = real admin API (backend/admin), mock = in-browser example data
VITE_ADMIN_DATA_SOURCE=http
# Base URL of the admin API (absolute, or relative to the panel's origin)
VITE_ADMIN_API_URL=/api/admin
# Dev server only: where Vite proxies /api requests (uvicorn admin.api:create_app --port 8100)
ADMIN_API_PROXY_TARGET=http://127.0.0.1:8100
